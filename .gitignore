# dependencies
/node_modules

# production
/dist*

# public directory auto-generated files
/public/sitemap.xml
/public/sitemap-*.xml
/public/robots.txt

# misc
/.*
!.editorconfig
!.gitignore
!.gitlab-ci.yml
!.eslint*
!.prettier*
!.stylelint*
npm-debug.log*
yarn-error.log

/coverage
.idea
.vscode
# package-lock.json
pnpm-lock.yaml
*bak